# Aquaflow-api — local development template
# Copy to `.env` (gitignored). Use Docker MySQL from `docker compose up`.
#
# Hostinger production: set DATABASE_URL / JWT_SECRET / FRONTEND_URL / CORS_ORIGINS
# in the Hostinger Node app env panel. Do not put Hostinger DB credentials in local .env
# (127.0.0.1 on Hostinger is the server itself; it is not reachable from your PC).

PORT=3001

# MySQL — local Docker defaults (docker-compose.yml)
DATABASE_URL=mysql://aquaflow:aquaflow@127.0.0.1:3306/aquaflow

# Or instead of DATABASE_URL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=aquaflow
# DB_PASSWORD=aquaflow
# DB_NAME=aquaflow

JWT_SECRET=change-me-in-production

# Secret code for POST /auth/platform/register (platform ops users only — not in DB)
PLATFORM_REGISTER_SECRET=aquaflow-platform-dev-secret

# Local Vite frontend
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 12 — Xendit (test mode). Never commit real secrets.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_PLAN_CODE=pro_monthly
XENDIT_PLAN_AMOUNT=499
XENDIT_CURRENCY=PHP
XENDIT_COUNTRY=PH
# XENDIT_API_BASE=https://api.xendit.co
# XENDIT_API_VERSION=2026-01-01
