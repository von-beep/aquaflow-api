# Server
PORT=3001

# MySQL — use DATABASE_URL or discrete fields
DATABASE_URL=mysql://aquaflow:aquaflow@127.0.0.1:3306/aquaflow

# Or instead of DATABASE_URL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=aquaflow
# DB_PASSWORD=aquaflow
# DB_NAME=aquaflow

# Auth
JWT_SECRET=change-me-in-production

# Frontend (checkout return URLs + CORS)
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins (in addition to FRONTEND_URL / localhost Vite)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 12 — Xendit (test mode keys from dashboard)
# Never commit real secrets.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_PLAN_CODE=pro_monthly
XENDIT_PLAN_AMOUNT=499
XENDIT_CURRENCY=PHP
XENDIT_COUNTRY=PH
# Optional overrides:
# XENDIT_API_BASE=https://api.xendit.co
# XENDIT_API_VERSION=2026-01-01
